ecuritySsoConnectionPage]}\n        sx={t => ({ gap: t.space.$8 })}\n      >\n        <Col\n          elementDescriptor={descriptors.profilePage}\n          elementId={descriptors.profilePage.setId('organizationSecurity')}\n        >\n          <ConnectionHeader\n            connection={connection}\n            onBack={onBack}\n          />\n\n          <NameSection\n            connection={connection}\n            updateConnection={updateConnection}\n          />\n\n          <DomainsSection connection={connection} />\n\n          {isOidc ? (\n            <OidcServiceProviderSection connection={connection} />\n          ) : (\n            <SamlServiceProviderSection connection={connection} />\n          )}\n\n          <IdentityProviderSection\n            connection={connection}\n            updateConnection={updateConnection}\n          />\n\n          <SettingsSection\n            connection={connection}\n            family={isOidc ? 'oidc' : 'saml'}\n            updateConnection={updateConnection}\n          />\n        </Col>\n      </Col>\n    </ProfileCard.Page>\n  );\n};\n\ntype ConnectionHeaderProps = Pick<EnterpriseConnectionPageProps, 'connection' | 'onBack'>;\n\nconst ConnectionHeader = ({ connection, onBack }: ConnectionHeaderProps): JSX.Element => {\n  const { status } = useOrganizationEnterpriseConnectionStatus(connection);\n\n  const badge = STATUS_BADGES[status];\n  const label = providerLabel(toProviderCard(connection.provider as EnterpriseConnectionProviderType));\n\n  return (\n    <Col sx={t => ({ gap: t.space.$4, marginBottom: t.space.$4 })}>\n      <Flex>\n        <SecurityBackControl onClick={onBack} />\n      </Flex>\n\n      <Flex\n        align='center'\n        wrap='wrap'\n        sx={t => ({ gap: t.space.$2 })}\n      >\n        <EnterpriseConnectionIcon connection={connection} />\n\n        <Col sx={{ minWidth: 0 }}>\n          <Header.Title textVariant='h2'>{connection.name}</Header.Title>\n          {label && (\n            <Text\n              colorScheme='secondary'\n              variant='caption'\n              localizationKey={label}\n            />\n          )}\n        </Col>\n\n        <Badge\n          elementDescriptor={descriptors.organizationProfileSecuritySsoBadge}\n          elementId={descriptors.organizationProfileSecuritySsoBadge.setId(badge.id)}\n          colorScheme={badge.colorScheme}\n          localizationKey={badge.label}\n        />\n      </Flex>\n    </Col>\n  );\n};\n"],"mappings":";;;;;;;;;;;;;;;;;;AA0BA,MAAa,4BAA4B,EACvC,YACA,+BAA+B,EAAE,oBACjC,aACgD;CAChD,MAAM,SAAS,eAAe,WAAW,QAAQ;CAEjD,OACE,oBAAC,YAAY,MAAb,YACE,oBAAC,KAAD;EACE,mBAAmB,CAAC,YAAY,MAAM,YAAY,4CAA4C;EAC9F,KAAI,OAAM,EAAE,KAAK,EAAE,MAAM,GAAG;YAE5B,qBAAC,KAAD;GACE,mBAAmB,YAAY;GAC/B,WAAW,YAAY,YAAY,MAAM,sBAAsB;aAFjE;IAIE,oBAAC,kBAAD;KACc;KACJ;IACT;IAED,oBAAC,aAAD;KACc;KACM;IACnB;IAED,oBAAC,gBAAD,EAA4B,WAAa;IAExC,SACC,oBAAC,4BAAD,EAAwC,WAAa,KAErD,oBAAC,4BAAD,EAAwC,WAAa;IAGvD,oBAAC,yBAAD;KACc;KACM;IACnB;IAED,oBAAC,iBAAD;KACc;KACZ,QAAQ,SAAS,SAAS;KACR;IACnB;GACE;;CACF,GACW;AAEtB;AAIA,MAAM,oBAAoB,EAAE,YAAY,aAAiD;CACvF,MAAM,EAAE,WAAW,0CAA0C,UAAU;CAEvE,MAAM,QAAQ,cAAc;CAC5B,MAAM,QAAQ,cAAc,eAAe,WAAW,QAA4C,CAAC;CAEnG,OACE,qBAAC,KAAD;EAAK,KAAI,OAAM;GAAE,KAAK,EAAE,MAAM;GAAI,cAAc,EAAE,MAAM;EAAG;YAA3D,CACE,oBAAC,MAAD,YACE,oBAAC,qBAAD,EAAqB,SAAS,OAAS,GACnC,IAEN,qBAAC,MAAD;GACE,OAAM;GACN,MAAK;GACL,KAAI,OAAM,EAAE,KAAK,EAAE,MAAM,GAAG;aAH9B;IAKE,oBAAC,0BAAD,EAAsC,WAAa;IAEnD,qBAAC,KAAD;KAAK,IAAI,EAAE,UAAU,EAAE;eAAvB,CACE,oBAAC,OAAO,OAAR;MAAc,aAAY;gBAAM,WAAW;KAAmB,IAC7D,SACC,oBAAC,MAAD;MACE,aAAY;MACZ,SAAQ;MACR,iBAAiB;KAClB,EAEA;;IAEL,oBAAC,OAAD;KACE,mBAAmB,YAAY;KAC/B,WAAW,YAAY,oCAAoC,MAAM,MAAM,EAAE;KACzE,aAAa,MAAM;KACnB,iBAAiB,MAAM;IACxB;GACG;IACH;;AAET"}