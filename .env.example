# ─────────────────────────────────────────────────────────────────────────────
# spotify-tracker configuration
#
# Local dev:  cp .env.example .env && docker compose up --build
# VPS prod:   cp .env.example .env && docker compose -f docker-compose.prod.yml up -d
# Coolify:    set these in the resource's Environment Variables tab instead
#             (SERVICE_* secrets are generated by Coolify automatically).
# ─────────────────────────────────────────────────────────────────────────────

# ─── General ──────────────────────────────────────────────────────────────────
# development | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# ─── Postgres (bundled container) ─────────────────────────────────────────────
POSTGRES_USER=tracker
# Use a URL-safe value (letters, digits, - and _).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spotify_tracker
# Host port for the dev compose stack (change if 5432 is taken).
POSTGRES_HOST_PORT=5432
# Only needed when running binaries outside Docker (`make run-api`):
DATABASE_URL=postgres://tracker:change-me@localhost:5432/spotify_tracker?sslmode=disable

# ─── Redis (bundled container) ────────────────────────────────────────────────
# Use a URL-safe value.
REDIS_PASSWORD=change-me
# Host port for the dev compose stack.
REDIS_HOST_PORT=6379
# Only needed when running binaries outside Docker:
REDIS_URL=redis://:change-me@localhost:6379/0

# ─── Internal gRPC auth (shared by api, poller, enricher) ─────────────────────
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=change-me-to-a-long-random-string
# Only needed when running workers outside Docker:
TRACKER_GRPC_ADDR=localhost:9000

# ─── Public API ───────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Response cache TTL for stats endpoints (Go duration).
CACHE_TTL=5m
# Also list private playlists on the public page (default: public only).
PUBLIC_SHOW_PRIVATE_PLAYLISTS=false
# Per-IP request limit for /v1 routes.
RATE_LIMIT_PER_MINUTE=240
# Auto-generated public "Top 50" Spotify playlists, created when each period
# ends (needs the playlist-modify-public scope: re-authorize Spotify in the
# admin once). Comma-separated week, month, year; "none" disables the feature.
# Local dev defaults to none: with week,month,year (the production default) the
# stack creates real, public playlists on the connected Spotify account.
TOP_PLAYLISTS_PERIODS=none
# IANA time zone for period boundaries and names (e.g. America/New_York).
TOP_PLAYLISTS_TIME_ZONE=UTC
# Kinds whose current (unfinished) period gets a live playlist right away,
# refreshed while listening and finalized in place when the period ends.
# Comma-separated week, month, year (must also be in TOP_PLAYLISTS_PERIODS);
# "none" disables live playlists.
TOP_PLAYLISTS_LIVE=week
# Time between two refreshes of a live playlist (Go duration, at least 10m).
TOP_PLAYLISTS_LIVE_REFRESH=1h
# Reverse proxies in front of the API that append X-Forwarded-For:
# 1 = Traefik (Coolify) or Caddy (VPS); 2 = Cloudflare proxy + one of those.
# Or set CLIENT_IP_HEADER=CF-Connecting-IP when behind Cloudflare.
TRUSTED_PROXY_HOPS=1
CLIENT_IP_HEADER=
# VPS prod (Caddy): public domain for the API, e.g. spotify-api.example.com
API_DOMAIN=

# ─── Secrets at rest (api) ────────────────────────────────────────────────────
# Encrypts the Spotify refresh token and SMTP password stored in Postgres.
# 32 bytes, hex or base64: openssl rand -hex 32. Keep it stable.
SECRETS_KEY=
# Public base URL of the API (OAuth redirects, Clerk authorized party).
PUBLIC_URL=http://127.0.0.1:8080

# ─── Admin dashboard (api, Clerk auth) ────────────────────────────────────────
# From the Clerk dashboard → API keys. Leave empty to disable /admin.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Who may use the dashboard (comma-separated). Either list may be used.
ADMIN_ALLOWED_EMAILS=
# Clerk users whose public_metadata.role equals this are admins too
# (set in Clerk dashboard → Users → Metadata). Empty disables role checks.
ADMIN_ROLE=admin
ADMIN_ALLOWED_USER_IDS=

# ─── Spotify (api) ────────────────────────────────────────────────────────────
# The API owns the Spotify credentials; workers get short-lived access tokens
# over gRPC. Authorize / re-authorize in the dashboard (Settings → Spotify);
# register <PUBLIC_URL>/admin/api/spotify/callback as a Redirect URI in the
# Spotify Developer Dashboard. Refresh tokens expire after 180 days.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional seed (e.g. migrating an existing token). Changing it re-seeds.
SPOTIFY_REFRESH_TOKEN=
# Date the seeded refresh token was issued (YYYY-MM-DD).
SPOTIFY_AUTHORIZED_AT=
# Optional override; defaults to <PUBLIC_URL>/admin/api/spotify/callback.
SPOTIFY_REDIRECT_URI=
# Optional: only this Spotify user ID may be connected (shown in Settings → Spotify).
SPOTIFY_OWNER_ID=
# Refresh-token lifetime in days, as shown in the Spotify dashboard.
SPOTIFY_TOKEN_LIFETIME_DAYS=180
# Poller interval in milliseconds (min 500).
POLL_INTERVAL_MS=3000

# ─── Alert emails (api: Spotify token expiry / auth failures) ─────────────────
# Seed values: copied into the database on first start (and whenever they
# change here); edit them in the dashboard (Settings → Email) afterwards.
# Alerts go out 14, 7, 3 and 1 day(s) before the Spotify token expires, on
# expiry, and when Spotify rejects the token.
# Port 465 = implicit TLS; other ports use STARTTLS when offered.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
# Comma-separated recipients.
ALERT_EMAIL_TO=

# ─── Soundcharts (enricher) ───────────────────────────────────────────────────
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_TOKEN=
# Client-side request rate limit shared by all workers (requests per second)
# and burst. Raise these to match your Soundcharts plan; on HTTP 429 the
# enricher pauses for Retry-After automatically.
SOUNDCHARTS_RPS=10
SOUNDCHARTS_BURST=5
# Tracks enriched in parallel.
ENRICH_CONCURRENCY=5
# Sweep interval for pending/retried tracks in milliseconds (min 1000).
ENRICH_INTERVAL_MS=60000
ENRICH_BATCH_SIZE=50
ENRICH_MAX_ATTEMPTS=8

# ─── One-off Directus import (cmd/importer) ───────────────────────────────────
# Base URL of the legacy Directus instance and token(s) that can read the
# artists, albums, tracks, track_features, listening_history and
# current_listening collections. A comma-separated list is tried in order per
# request, so the old worker-poll and worker-enrich tokens can be combined.
DIRECTUS_URL=
DIRECTUS_TOKEN=
