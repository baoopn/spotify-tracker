{
  "workspace": [
    "./apps/frontend",
    "./apps/worker-poll",
    "./apps/worker-enrich",
    "./packages/shared"
  ],
  "lock": true,
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "@shared/": "./packages/shared/",
    "@shared/schemas": "./packages/shared/schemas.ts",
    "zod": "npm:zod@^4.3.6"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "exclude": [
      "**/.svelte-kit/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**"
    ]
  },
  "lint": {
    "exclude": [
      "**/.svelte-kit/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**"
    ]
  },
  "tasks": {
    "check": "deno check packages/shared/schemas.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "dev:worker-poll": "deno run --allow-env --env --allow-net --watch apps/worker-poll/src/index.ts",
    "start:worker-poll": "deno run --allow-env --allow-net apps/worker-poll/src/index.ts",
    "dev:worker-enrich": "deno run --allow-env --env --allow-net --watch apps/worker-enrich/src/index.ts",
    "start:worker-enrich": "deno run --allow-env --allow-net apps/worker-enrich/src/index.ts"
  }
}