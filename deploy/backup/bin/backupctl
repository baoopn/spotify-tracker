#!/bin/sh
# backupctl: encrypted, off-site PostgreSQL backups for spotify-tracker.
#
#   backupctl run                 daily scheduler (BACKUP_TIME or admin setting, UTC)
#   backupctl backup              one backup now
#   backupctl list                list backups, newest first
#   backupctl restore [latest|NAME] [--force] [--to-file PATH] [-i PATH|-]
#   backupctl verify  [latest|NAME] [-i PATH|-]
#   backupctl prune               apply BACKUP_KEEP_DAYS / BACKUP_KEEP_MIN
#   backupctl keygen              new age key pair (identity on stdout)
#   backupctl health              container healthcheck
#
# Configuration is env, plus the admin settings for time, retention and
# pause (settings key 'backup'); see docs/backup.md.
# shellcheck source-path=SCRIPTDIR
set -u

LIB_DIR=$(dirname "$0")
# shellcheck source=backupctl-common.sh
. "$LIB_DIR/backupctl-common.sh"
# shellcheck source=backupctl-backup.sh
. "$LIB_DIR/backupctl-backup.sh"
# shellcheck source=backupctl-restore.sh
. "$LIB_DIR/backupctl-restore.sh"
# shellcheck source=backupctl-status.sh
. "$LIB_DIR/backupctl-status.sh"
# shellcheck source=backupctl-run.sh
. "$LIB_DIR/backupctl-run.sh"

usage() {
	sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
}

# cmd_backup_cli: "backupctl backup". Records the run (trigger manual) and
# refreshes the inventory when the database has the status tables.
cmd_backup_cli() {
	if db_usable && status_check; then :; fi
	backup_with_status manual "" || return 1
	if setup_storage 2>/dev/null; then inventory_refresh || true; fi
}

# cmd_prune_cli: "backupctl prune", then an inventory refresh.
cmd_prune_cli() {
	(cmd_prune)
	rc=$?
	if db_usable && status_check && setup_storage 2>/dev/null; then inventory_refresh || true; fi
	return "$rc"
}

# cmd_health: unhealthy when misconfigured. Healthy while idle (nothing set)
# or paused by the admin settings,
# while waiting for the first scheduled run (plus retry and an hour of
# slack), or when the last success is recent.
cmd_health() {
	now=$(date -u +%s)
	if [ -f "$STATUS_DIR/idle" ]; then
		echo "idle: $(status_read idle)"
		return 0
	fi
	if [ -f "$STATUS_DIR/misconfigured" ]; then
		echo "unhealthy: misconfigured: $(status_read misconfigured)"
		return 1
	fi
	if [ -f "$STATUS_DIR/paused" ]; then
		echo "ok: paused by the admin settings"
		return 0
	fi
	first_due=$(status_read first_due)
	if [ -z "$first_due" ]; then
		echo "ok: scheduler not running"
		return 0
	fi
	max_hours=${BACKUP_MAX_AGE_HOURS:-26}
	is_uint "$max_hours" || max_hours=26
	retry=${BACKUP_RETRY_MINUTES:-30}
	is_uint "$retry" || retry=30
	last=$(status_read last_success)
	if [ -n "$last" ] && [ $((now - last)) -le $((max_hours * 3600)) ]; then
		echo "ok: last backup $(((now - last) / 60)) minute(s) ago"
		return 0
	fi
	if [ -z "$last" ] && [ "$now" -lt $((first_due + (retry + 60) * 60)) ]; then
		echo "ok: waiting for the first backup"
		return 0
	fi
	echo "unhealthy: no successful backup in the last $max_hours hours"
	return 1
}

cmd_keygen() {
	key=$(age-keygen 2>/dev/null) || die "age-keygen failed"
	pub=$(printf '%s\n' "$key" | age-keygen -y) || die "cannot derive the public key"
	printf '%s\n' "$key"
	{
		echo
		echo "The age identity (private key) was written to stdout."
		echo "Store it safely and offline (password manager): it is the ONLY way to"
		echo "decrypt your backups and it never goes on the server."
		echo
		echo "Public recipient (set this as BACKUP_AGE_RECIPIENT):"
		echo "  $pub"
	} >&2
	if [ -t 1 ]; then
		warn "stdout is a terminal: redirect it to a file, e.g. backupctl keygen > key.txt"
	fi
}

cmd=${1:-help}
[ $# -eq 0 ] || shift
case $cmd in
run) cmd_run ;;
backup) cmd_backup_cli ;;
list) cmd_list ;;
restore) cmd_restore "$@" ;;
verify) cmd_verify "$@" ;;
prune) cmd_prune_cli ;;
keygen) cmd_keygen ;;
health) cmd_health ;;
help | -h | --help) usage ;;
*)
	usage >&2
	die "unknown command: $cmd"
	;;
esac
