{"version":3,"file":"useOrganizationListInView.js","names":[],"sources":["../../src/hooks/useOrganizationListInView.ts"],"sourcesContent":["import { useOrganizationList } from '@clerk/shared/react/index';\n\nimport { organizationListParams } from '../components/OrganizationSwitcher/utils';\nimport { useInView } from './useInView';\n\n/**\n * @internal\n *\n * `enabled` withholds the list params so the three requests do not start. Defaults on.\n */\nexport const useOrganizationListInView = ({ enabled = true }: { enabled?: boolean } = {}) => {\n  const { userMemberships, userInvitations, userSuggestions } = useOrganizationList(\n    enabled ? organizationListParams : undefined,\n  );\n\n  const { ref } = useInView({\n    threshold: 0,\n    onChange: inView => {\n      if (!enabled || !inView) {\n        return;\n      }\n      if (userMemberships.hasNextPage) {\n        userMemberships.fetchNext?.();\n      } else if (userInvitations.hasNextPage) {\n        userInvitations.fetchNext?.();\n      } else {\n        userSuggestions.fetchNext?.();\n      }\n    },\n  });\n\n  return {\n    userMemberships,\n    userInvitations,\n    userSuggestions,\n    ref,\n  };\n};\n"],"mappings":";;;;;;;;;;AAUA,MAAa,6BAA6B,EAAE,UAAU,SAAgC,CAAC,MAAM;CAC3F,MAAM,EAAE,iBAAiB,iBAAiB,oBAAoB,oBAC5D,UAAU,yBAAyB,MACrC;CAEA,MAAM,EAAE,QAAQ,UAAU;EACxB,WAAW;EACX,WAAU,WAAU;GAClB,IAAI,CAAC,WAAW,CAAC,QACf;GAEF,IAAI,gBAAgB,aAClB,gBAAgB,YAAY;QACvB,IAAI,gBAAgB,aACzB,gBAAgB,YAAY;QAE5B,gBAAgB,YAAY;EAEhC;CACF,CAAC;CAED,OAAO;EACL;EACA;EACA;EACA;CACF;AACF"}