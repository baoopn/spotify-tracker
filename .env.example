# Directus (required)
# Example: https://directus.example.com
DIRECTUS_URL=
DIRECTUS_TOKEN=
# Use worker-specific tokens if you want separate permissions for each worker.
DIRECTUS_TOKEN_WORKER_POLL=
DIRECTUS_TOKEN_WORKER_ENRICH=

# Soundcharts API credentials (at least the first pair is required)
# You may provide multiple credential sets to rotate through: pairs numbered _2, _3, ...
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_TOKEN=
SOUNDCHARTS_APP_ID_2=
SOUNDCHARTS_TOKEN_2=
SOUNDCHARTS_APP_ID_3=
SOUNDCHARTS_TOKEN_3=

# Spotify OAuth (used by the poller)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Polling intervals (milliseconds). Defaults: POLL_INTERVAL_MS=5000, ENRICH_INTERVAL_MS=300000
# Set these to tune how often each worker runs. Must be a positive integer.
POLL_INTERVAL_MS=
ENRICH_INTERVAL_MS=