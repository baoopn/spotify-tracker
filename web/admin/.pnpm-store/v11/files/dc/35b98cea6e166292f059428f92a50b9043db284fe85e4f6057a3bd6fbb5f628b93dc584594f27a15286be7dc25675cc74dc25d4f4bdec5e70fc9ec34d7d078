oot>\n  );\n};\n\nconst ServiceProviderSectionRoot = ({ children }: { children: ReactNode }): JSX.Element => (\n  <ProfileSection.Root\n    title={localizationKeys('organizationProfile.securityPage.connectionPage.serviceProvider.title')}\n    id='ssoConnectionServiceProvider'\n    centered={false}\n  >\n    <Col gap={4}>{children}</Col>\n  </ProfileSection.Root>\n);\n\nconst CopyableValue = ({ label, value }: { label: LocalizationKey; value: string }): JSX.Element => {\n  const { t } = useLocalizations();\n\n  return (\n    <Col gap={1}>\n      <Text\n        colorScheme='secondary'\n        variant='caption'\n        localizationKey={label}\n      />\n      <ClipboardInput\n        value={value}\n        readOnly\n        aria-label={t(label)}\n        copyIcon={Clipboard}\n        copiedIcon={Checkmark}\n      />\n    </Col>\n  );\n};\n"],"mappings":";;;;;;;;;;AAUA,MAAa,8BAA8B,EACzC,iBAGwB;CACxB,MAAM,OAAO,WAAW;CAExB,IAAI,CAAC,MACH,OAAO;CAGT,OACE,qBAAC,4BAAD;EACE,oBAAC,eAAD;GACE,OAAO,iBAAiB,wEAAwE;GAChG,OAAO,KAAK;EACb;EACD,oBAAC,eAAD;GACE,OAAO,iBAAiB,0EAA0E;GAClG,OAAO,KAAK;EACb;EACD,oBAAC,eAAD;GACE,OAAO,iBAAiB,6EAA6E;GACrG,OAAO,KAAK;EACb;CACyB;AAEhC;AAEA,MAAa,8BAA8B,EACzC,iBAGwB;CACxB,MAAM,cAAc,WAAW,aAAa;CAE5C,IAAI,CAAC,aACH,OAAO;CAGT,OACE,oBAAC,4BAAD,YACE,oBAAC,eAAD;EACE,OAAO,iBAAiB,6EAA6E;EACrG,OAAO;CACR,GACyB;AAEhC;AAEA,MAAM,8BAA8B,EAAE,eACpC,oBAAC,eAAe,MAAhB;CACE,OAAO,iBAAiB,uEAAuE;CAC/F,IAAG;CACH,UAAU;WAEV,oBAAC,KAAD;EAAK,KAAK;EAAI;CAAc;AACT;AAGvB,MAAM,iBAAiB,EAAE,OAAO,YAAoE;CAClG,MAAM,EAAE,MAAM,iBAAiB;CAE/B,OACE,qBAAC,KAAD;EAAK,KAAK;YAAV,CACE,oBAAC,MAAD;GACE,aAAY;GACZ,SAAQ;GACR,iBAAiB;EAClB,IACD,oBAAC,gBAAD;GACS;GACP;GACA,cAAY,EAAE,KAAK;GACnB,UAAUA;GACV,YAAYC;EACb,EACE;;AAET"}