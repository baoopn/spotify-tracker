# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Go
/bin/
/dist/
coverage.out
*.test

# Admin SPA
web/admin/node_modules/
web/admin/.svelte-kit/
web/admin/build/*
!web/admin/build/.gitkeep

# Public site
web/public/node_modules/
web/public/.svelte-kit/
web/public/build/*
!web/public/build/.gitkeep

# Environment & secrets
.env
.env.*
!.env.example

# Local data
/backups/
tmp/
*.log

# Ruflo runtime state (config is committed, data is not). These files are
# machine/session specific (absolute cache paths, timestamps, policy state).
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.claude-flow/metrics/
.claude-flow/memory-package.json
.claude-flow/policy/
.claude-flow/swarm/
.claude-flow/security/
.claude-flow/harness-active-policy.json
.claude/proven-config.json
.claude/.proven-config-version
.swarm/
.hive-mind/
.claude/settings.local.json

# Local deployment secrets (prod env, Clerk keys, deploy keys) - never commit
.secrets/

# Tool scan outputs (ruflo security scans)
.claude/security-scans/
web/*/.claude/

# pnpm store created by the dev containers
.pnpm-store/

# Agent worktrees (one per parallel writer)
/.worktrees/

# Email previews (go run ./cmd/emailpreview)
/email-preview/
