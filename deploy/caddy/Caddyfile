{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Only the public REST API is exposed; gRPC (9000) and ops (9090) stay internal.
	reverse_proxy api:8080 {
		# Required for the Server-Sent Events stream.
		flush_interval -1
	}

	log {
		output stdout
		format json
	}
}
