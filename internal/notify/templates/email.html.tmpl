<!doctype html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no,date=no,address=no,email=no,url=no">
<title>{{.Subject}}</title>
{{msoHead}}
<style>
@media (max-width: 620px) {
  .card { width: 100% !important; }
  .pad { padding-left: 20px !important; padding-right: 20px !important; }
}
</style>
<style>
:root { color-scheme: light dark; }
@media (prefers-color-scheme: dark) {
  .paper { background-color: #24212e !important; }
  .card { background-color: #2d2939 !important; border-color: #49465a !important; }
  .ink { color: #f2ecf9 !important; }
  .soft { color: #bdb5cf !important; }
  .rule { border-color: #49465a !important; }
  .code { background-color: #353043 !important; color: #f2ecf9 !important; border-color: #5b5373 !important; }
  .btn { background-color: #f2ecf9 !important; }
  .btn-a { color: #24212e !important; }
  .pill { background-color: #fff5eb !important; }
  .logo { color: #0b0537 !important; }
  .t-info { background-color: #c6b4ef !important; }
  .t-warning { background-color: #e8d68e !important; }
  .t-danger { background-color: #eaa9bd !important; }
  .t-success { background-color: #a8d8bf !important; }
  .chip { color: #3b3552 !important; }
}
/* Outlook apps: the button keeps its navy fill and cream text (no
   [data-ogsc]/[data-ogsb] rule), so text and fill always contrast. */
[data-ogsc] .ink { color: #f2ecf9 !important; }
[data-ogsc] .soft { color: #bdb5cf !important; }
[data-ogsc] .chip { color: #3b3552 !important; }
[data-ogsc] .logo { color: #0b0537 !important; }
[data-ogsc] .code { color: #f2ecf9 !important; }
[data-ogsb] .paper { background-color: #24212e !important; }
[data-ogsb] .card { background-color: #2d2939 !important; }
[data-ogsb] .code { background-color: #353043 !important; }
[data-ogsb] .pill { background-color: #fff5eb !important; }
[data-ogsb] .t-info { background-color: #c6b4ef !important; }
[data-ogsb] .t-warning { background-color: #e8d68e !important; }
[data-ogsb] .t-danger { background-color: #eaa9bd !important; }
[data-ogsb] .t-success { background-color: #a8d8bf !important; }
</style>
</head>
<body class="paper" style="margin:0;padding:0;background-color:#fbf7f2;-webkit-text-size-adjust:100%;">
<div style="display:none;max-height:0;max-width:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#fbf7f2;opacity:0;">{{.Preheader}}{{preheaderPad}}</div>
<table role="presentation" class="paper" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#fbf7f2" style="width:100%;background-color:#fbf7f2;">
<tr><td align="center" style="padding:28px 12px 40px;">
{{msoOpen}}
<table role="presentation" class="card" width="600" cellpadding="0" cellspacing="0" border="0" bgcolor="#fffaf5" style="max-width:600px;width:100%;background-color:#fffaf5;border:1px solid #ece4f2;border-radius:16px;overflow:hidden;">
<tr><td class="{{.Tone.Class}}" height="6" bgcolor="{{.Tone.Fill}}" style="height:6px;background-color:{{.Tone.Fill}};font-size:6px;line-height:6px;mso-line-height-rule:exactly;">&nbsp;</td></tr>
<tr><td class="pad" style="padding:28px 40px 0;">
{{- if .Brand.LogoURL}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td class="pill" bgcolor="#fff5eb" style="background-color:#fff5eb;border-radius:22px;padding:6px;">
{{- if .Brand.URL}}<a href="{{.Brand.URL}}" style="display:block;text-decoration:none;border:0;">{{template "logo" .}}</a>{{else}}{{template "logo" .}}{{end -}}
</td></tr></table>
{{- else}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#0b0537" style="background-color:#0b0537;border-radius:8px;padding:6px 12px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;line-height:1.2;color:#fff5eb;">baoopn listening</td></tr></table>
{{- end}}
</td></tr>
<tr><td class="pad" style="padding:24px 40px 0;">
{{- if .Badge}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td class="chip {{.Tone.Class}}" bgcolor="{{.Tone.Fill}}" style="background-color:{{.Tone.Fill}};border-radius:999px;padding:5px 12px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;line-height:1.2;color:#3b3552;">{{.Badge}}</td></tr></table>
{{- end}}
{{- if .Title}}
<h1 class="ink" style="margin:14px 0 0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.3;color:#3b3552;overflow-wrap:anywhere;word-break:break-word;">{{.Title}}</h1>
{{- end}}
</td></tr>
<tr><td class="pad" style="padding:18px 40px 8px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.5;color:#3b3552;overflow-wrap:anywhere;word-break:break-word;">
{{- range .Paragraphs}}
<p class="ink" style="margin:0 0 16px;font-size:16px;line-height:1.5;color:#3b3552;">{{.}}</p>
{{- end}}
{{- if .Facts}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin:4px 0 20px;border-top:1px solid #efe8f3;" class="rule">
{{- range .Facts}}
<tr><td class="soft rule" width="140" valign="top" style="width:140px;padding:10px 12px 10px 0;border-bottom:1px solid #efe8f3;font-size:14px;line-height:1.5;color:#6b6585;">{{.Label}}</td><td class="ink rule" valign="top" style="padding:10px 0;border-bottom:1px solid #efe8f3;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,'Liberation Mono',monospace;font-size:14px;line-height:1.5;color:#3b3552;overflow-wrap:anywhere;word-break:break-word;">{{.Value}}</td></tr>
{{- end}}
</table>
{{- end}}
{{- if .Code}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin:0 0 20px;table-layout:fixed;"><tr><td class="code" bgcolor="#f4eefa" style="background-color:#f4eefa;border-left:3px solid #e3d7fb;border-radius:10px;padding:14px 16px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,'Liberation Mono',monospace;font-size:13px;line-height:1.6;color:#3b3552;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-all;">{{.Code}}</td></tr></table>
{{- end}}
{{- if .ActionURL}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 16px;"><tr><td>
{{vmlButton .ActionURL .Action.Label}}
{{notMsoOpen}}<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td class="btn" bgcolor="#0b0537" style="background-color:#0b0537;border-radius:999px;"><a class="btn-a" href="{{.ActionURL}}" style="display:inline-block;padding:14px 28px;min-height:20px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;font-weight:700;line-height:20px;color:#fff5eb;text-decoration:none;border-radius:999px;">{{.Action.Label}}</a></td></tr></table>{{notMsoClose}}
</td></tr></table>
{{- end}}
{{- if .Note}}
<p class="soft" style="margin:0 0 16px;font-size:14px;line-height:1.5;color:#6b6585;">{{.Note}}</p>
{{- end}}
</td></tr>
<tr><td class="pad" style="padding:0 40px 28px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;"><tr><td class="soft rule" style="border-top:1px solid #efe8f3;padding-top:18px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#6b6585;">
Sent by spotify-tracker{{with .Brand.URL}} &middot; <a class="soft" href="{{.}}" style="color:#6b6585;text-decoration:underline;"><span class="soft" style="color:#6b6585;">{{$.Brand.Host}}</span></a>{{end}}<br>
You get these because you&#8217;re an alert recipient. Change it in {{with .SettingsURL}}<a class="soft" href="{{.}}" style="color:#6b6585;text-decoration:underline;"><span class="soft" style="color:#6b6585;">Settings &rarr; Email alerts</span></a>{{else}}Settings &rarr; Email alerts{{end}}.
</td></tr></table>
</td></tr>
</table>
{{msoClose}}
</td></tr>
</table>
</body>
</html>
{{- /* logo is the header wordmark. The alt text is styled so the email
still reads well with images off. */}}
{{- define "logo"}}<img class="logo" src="{{.Brand.LogoURL}}" width="{{.LogoW}}" height="{{.LogoH}}" alt="baoopn listening" style="display:block;border:0;outline:none;text-decoration:none;width:{{.LogoW}}px;height:{{.LogoH}}px;max-width:{{.LogoW}}px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;font-weight:700;line-height:{{.LogoH}}px;text-align:center;color:#0b0537;border-radius:16px;">{{end}}
