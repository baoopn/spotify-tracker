{"version":3,"file":"roleMapping.js","names":[],"sources":["../../../../src/components/ConfigureDirectorySync/roleMapping.ts"],"sourcesContent":["export type RoleOption = { value: string; label: string; description?: string };\n\n/**\n * A directory group bound to an organization role. Priority is the position\n * in the mappings array: index 0 wins when a user belongs to several mapped\n * groups.\n */\nexport type GroupRoleMapping = {\n  groupId: string;\n  groupName: string;\n  roleKey: string;\n};\n\nexport type UnmappedGroup = {\n  id: string;\n  name: string;\n};\n\nexport const NO_ROLE_KEY = 'no_role';\n\nexport const moveItem = <T>(items: T[], from: number, to: number): T[] => {\n  if (from === to || from < 0 || to < 0 || from >= items.length || to >= items.length) {\n    return items;\n  }\n  const next = items.slice();\n  const [moved] = next.splice(from, 1);\n  next.splice(to, 0, moved);\n  return next;\n};\n"],"mappings":";AAkBA,MAAa,cAAc;AAE3B,MAAa,YAAe,OAAY,MAAc,OAAoB;CACxE,IAAI,SAAS,MAAM,OAAO,KAAK,KAAK,KAAK,QAAQ,MAAM,UAAU,MAAM,MAAM,QAC3E,OAAO;CAET,MAAM,OAAO,MAAM,MAAM;CACzB,MAAM,CAAC,SAAS,KAAK,OAAO,MAAM,CAAC;CACnC,KAAK,OAAO,IAAI,GAAG,KAAK;CACxB,OAAO;AACT"}