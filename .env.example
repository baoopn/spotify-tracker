# ─────────────────────────────────────────────────────────────────────────────
# spotify-tracker configuration
#
# Local dev:  cp .env.example .env && docker compose up --build
# VPS prod:   cp .env.example .env && docker compose -f docker-compose.prod.yml up -d
# Coolify:    set these in the resource's Environment Variables tab instead
#             (SERVICE_* secrets are generated by Coolify automatically).
# ─────────────────────────────────────────────────────────────────────────────

# ─── General ──────────────────────────────────────────────────────────────────
# development | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# ─── Postgres (bundled container) ─────────────────────────────────────────────
POSTGRES_USER=tracker
# Use a URL-safe value (letters, digits, - and _).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spotify_tracker
# Host port for the dev compose stack (change if 5432 is taken).
POSTGRES_HOST_PORT=5432
# Only needed when running binaries outside Docker (`make run-api`):
DATABASE_URL=postgres://tracker:change-me@localhost:5432/spotify_tracker?sslmode=disable

# ─── Redis (bundled container) ────────────────────────────────────────────────
# Letters and digits only: it goes into a redis.conf line and into REDIS_URL.
REDIS_PASSWORD=change-me
# Host port for the dev compose stack.
REDIS_HOST_PORT=6379
# Only needed when running binaries outside Docker:
REDIS_URL=redis://:change-me@localhost:6379/0

# ─── Internal gRPC auth (shared by api, poller, enricher) ─────────────────────
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=change-me-to-a-long-random-string
# Only needed when running workers outside Docker:
TRACKER_GRPC_ADDR=localhost:9000

# ─── Public API ───────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Response cache TTL for stats endpoints (Go duration).
CACHE_TTL=5m
# Also list private playlists on the public page (default: public only).
PUBLIC_SHOW_PRIVATE_PLAYLISTS=false
# Per-IP request limit for /v1 routes.
RATE_LIMIT_PER_MINUTE=240
# Auto-generated public "Top 50" Spotify playlists, created when each period
# ends (needs the playlist-modify-public scope: re-authorize Spotify in the
# admin once). Comma-separated week, month, year; "none" disables the feature.
# Local dev defaults to none: with week,month,year (the production default) the
# stack creates real, public playlists on the connected Spotify account.
TOP_PLAYLISTS_PERIODS=none
# IANA time zone for period boundaries and names (e.g. America/New_York).
TOP_PLAYLISTS_TIME_ZONE=UTC
# Kinds whose current (unfinished) period gets a live playlist right away,
# refreshed while listening and finalized in place when the period ends.
# Comma-separated week, month, year (must also be in TOP_PLAYLISTS_PERIODS);
# "none" disables live playlists.
TOP_PLAYLISTS_LIVE=week
# Time between two refreshes of a live playlist (Go duration, at least 10m).
TOP_PLAYLISTS_LIVE_REFRESH=1h
# Playlists kept per kind, the live one included (3 = live week + 2 finished
# weeks). Older ones are deleted from Spotify and dropped from the public
# page; the admin keeps them as history. 0 keeps every playlist.
TOP_PLAYLISTS_KEEP=3
# How often the published playlists are checked against your Spotify library;
# one you deleted in the Spotify app is restored. Go duration, at least 10m;
# 0 or off disables the checks.
TOP_PLAYLISTS_VERIFY=1h
# Name in "{owner}'s Top 50 · Week of …" (at most 40 characters). Empty uses
# the connected Spotify account's display name.
TOP_PLAYLISTS_OWNER=
# Reverse proxies in front of the API that append X-Forwarded-For:
# 1 = Traefik (Coolify) or Caddy (VPS); 2 = Cloudflare proxy + one of those.
# Or set CLIENT_IP_HEADER=CF-Connecting-IP when behind Cloudflare.
TRUSTED_PROXY_HOPS=1
CLIENT_IP_HEADER=
# VPS prod (Caddy): public domain for the API, e.g. spotify-api.example.com
API_DOMAIN=

# ─── Secrets at rest (api) ────────────────────────────────────────────────────
# Encrypts the Spotify refresh token and SMTP password stored in Postgres.
# 32 bytes, hex or base64: openssl rand -hex 32. Keep it stable.
SECRETS_KEY=
# Public base URL of the API (OAuth redirects, Clerk authorized party).
PUBLIC_URL=http://127.0.0.1:8080

# ─── Admin dashboard (api, Clerk auth) ────────────────────────────────────────
# From the Clerk dashboard → API keys. Leave empty to disable /admin.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Who may use the dashboard (comma-separated). Either list may be used.
ADMIN_ALLOWED_EMAILS=
# Clerk users whose public_metadata.role equals this are admins too
# (set in Clerk dashboard → Users → Metadata). Empty disables role checks.
ADMIN_ROLE=admin
ADMIN_ALLOWED_USER_IDS=

# ─── MCP endpoint (api, /mcp) ─────────────────────────────────────────────────
# Remote MCP server (Streamable HTTP) for AI clients such as Claude. Without a
# token it serves the public, read-only tools; false answers 404 at /mcp.
MCP_ENABLED=true
# Optional bootstrap bearer token for the read-only admin tools (at least 32
# characters: openssl rand -hex 32). Prefer the token generated in the
# dashboard (Settings -> MCP); both work. Empty: dashboard token only.
MCP_ADMIN_TOKEN=
# Per-IP request limit for /mcp.
MCP_RATE_LIMIT_PER_MINUTE=60

# ─── Lyrics (LRCLIB) ────────────────────────────────────────────────────────
# The API looks up track lyrics on LRCLIB (https://lrclib.net, no key needed)
# in the background. Lyrics are shown in the admin dashboard and the admin MCP
# tools only; the public API never returns them. false makes no LRCLIB calls.
LYRICS_ENABLED=true
LYRICS_API_URL=https://lrclib.net
# Pause between batches (10s..24h) and tracks per batch (1..100).
LYRICS_INTERVAL=1m
LYRICS_BATCH=10
# Minimum time between two LRCLIB requests (1s..1m).
LYRICS_SPACING=2s
# When a track with no lyrics found is checked again (24h..8760h).
LYRICS_NOT_FOUND_RETRY=720h

# ─── Play counting (api) ──────────────────────────────────────────────────────
# A listen counts as one play once this share of the song has been heard
# (30 s when the duration is unknown); skips below it are not counted.
# 0.05 to 0.9.
PLAY_COUNT_MIN_FRACTION=0.3
# A paused or idle song that resumes within this window continues the same
# listen instead of counting another play. 1m to 720h.
PLAY_RESUME_WINDOW=24h
# Jumping back this far on a counted listen (or back to the start) begins the
# next listen of the same song, counted as a replay. Up to 10m.
REPLAY_RESET_THRESHOLD=10s
# ─── Lyrics translation (Claude) ────────────────────────────────────────────
# Translates found lyrics into English and Vietnamese with the Claude API,
# shown on the public now-playing lyrics and in the admin dashboard. Songs
# are queued only when they play (the song playing now first, then plays
# within TRANSLATE_RECENT_WINDOW) or when re-queued in the admin; the library
# is never backfilled. Each call uses Anthropic API credit: keep the caps set.
TRANSLATE_ENABLED=false
# Anthropic API key (Claude Console). Required when enabled; never logged.
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-opus-5-5
# Claude effort: low or medium.
TRANSLATE_EFFORT=low
# Pause between batches when nothing wakes the worker (10s..24h), songs per
# batch (1..50), and the minimum time between two Claude calls (1s..10m).
TRANSLATE_INTERVAL=1m
TRANSLATE_BATCH=5
TRANSLATE_SPACING=15s
# How long a worker holds a queued song (5m..1h); a crashed worker's claim
# expires after it.
TRANSLATE_LEASE=10m
# Also queue songs played this recently (0..24h; 0 = only the song playing now).
TRANSLATE_RECENT_WINDOW=30m
# Claude calls per UTC day (0..10000) and month (0..100000); 0 = no cap of that
# kind, but at least one must be set.
TRANSLATE_DAILY_CAP=100
TRANSLATE_MONTHLY_CAP=1000
# Failures in a row before a song is given up (1..20; re-queue to try again).
TRANSLATE_MAX_ATTEMPTS=5

# ─── Spotify (api) ────────────────────────────────────────────────────────────
# The API owns the Spotify credentials; workers get short-lived access tokens
# over gRPC. Authorize / re-authorize in the dashboard (Settings → Spotify);
# register <PUBLIC_URL>/admin/api/spotify/callback as a Redirect URI in the
# Spotify Developer Dashboard. Refresh tokens expire after 180 days.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional seed (e.g. migrating an existing token). Changing it re-seeds.
SPOTIFY_REFRESH_TOKEN=
# Date the seeded refresh token was issued (YYYY-MM-DD).
SPOTIFY_AUTHORIZED_AT=
# Optional override; defaults to <PUBLIC_URL>/admin/api/spotify/callback.
SPOTIFY_REDIRECT_URI=
# Optional: only this Spotify user ID may be connected (shown in Settings → Spotify).
SPOTIFY_OWNER_ID=
# Refresh-token lifetime in days, as shown in the Spotify dashboard.
SPOTIFY_TOKEN_LIFETIME_DAYS=180
# Poller interval in milliseconds (min 500).
POLL_INTERVAL_MS=3000

# ─── Queue prefetch (poller + api) ────────────────────────────────────────────
# While a song plays, the poller reads the Spotify queue (on a track change and
# every QUEUE_PREFETCH_RECHECK) and the API stores the next tracks' catalog rows
# and starts their lyrics, translation and metadata lookups, so everything is
# ready when they start. Never counts a play. The queue stays private: it is
# shown in the admin overview only.
QUEUE_PREFETCH_ENABLED=true
# Upcoming tracks to prefetch (1..5).
QUEUE_PREFETCH_DEPTH=1
# Re-read the queue this often while one song plays (15s..10m).
QUEUE_PREFETCH_RECHECK=60s
# A prefetched track is not prefetched again for this long (1m..48h).
QUEUE_PREFETCH_TTL=6h
# (api) Queue upcoming tracks for Claude translation, within the translation
# caps; a song that is then skipped still costs a call. No effect when
# TRANSLATE_ENABLED=false.
QUEUE_PREFETCH_TRANSLATE=true
# (api) Queue Soundcharts enrichment for upcoming tracks (uses quota). Off,
# a track is enriched when it plays.
QUEUE_PREFETCH_ENRICH=false
# (api) Look up album details and artist images (Spotify API) for upcoming tracks.
QUEUE_PREFETCH_DETAILS=true

# ─── Alert emails (api: Spotify token expiry / auth failures) ─────────────────
# Seed values: copied into the database on first start (and whenever they
# change here); edit them in the dashboard (Settings → Email) afterwards.
# Alerts go out 14, 7, 3 and 1 day(s) before the Spotify token expires, on
# expiry, and when Spotify rejects the token.
# Port 465 = implicit TLS; other ports use STARTTLS when offered.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
# Comma-separated recipients.
ALERT_EMAIL_TO=
# Absolute http(s) URL of the wordmark PNG in the alert email header. The logo
# is picked at send time in this order: the brand API's email_logo (see
# BRAND_API_URL below) -> EMAIL_LOGO_URL -> <PUBLIC_URL>/email/listening-
# wordmark-primary@2x.png (served by the api from web/public/static/email/).
# An invalid value is logged and ignored.
EMAIL_LOGO_URL=

# ─── Brand assets ─────────────────────────────────────────────────────────────
# Logos, icons, favicons, og:image and the email logo come from the baoopn brand
# API, so a file replaced in the baoopn admin shows up within minutes. The last
# good copy is kept when the API is down; the static copies in
# web/public/static are the fallback. Unset = the default below; empty or
# "off" disables the API (static copies always). Only https URLs on media.baoopn.com
# or baoopn.com are accepted from the API.
BRAND_API_URL=https://baoopn.com/api/v1/brand/listening
# Time between two fetches of the brand API (Go duration, 10s..24h).
BRAND_REFRESH=60s

# ─── Soundcharts (enricher) ───────────────────────────────────────────────────
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_TOKEN=
# Client-side request rate limit shared by all workers (requests per second)
# and burst. Raise these to match your Soundcharts plan; on HTTP 429 the
# enricher pauses for Retry-After automatically.
SOUNDCHARTS_RPS=10
SOUNDCHARTS_BURST=5
# Tracks enriched in parallel.
ENRICH_CONCURRENCY=5
# Sweep interval for pending/retried tracks in milliseconds (min 1000).
ENRICH_INTERVAL_MS=60000
ENRICH_BATCH_SIZE=50
ENRICH_MAX_ATTEMPTS=8

# ─── One-off Directus import (cmd/importer) ───────────────────────────────────
# Base URL of the legacy Directus instance and token(s) that can read the
# artists, albums, tracks, track_features, listening_history and
# current_listening collections. A comma-separated list is tried in order per
# request, so the old worker-poll and worker-enrich tokens can be combined.
DIRECTUS_URL=
DIRECTUS_TOKEN=

# ─── Off-site backups (backup / offsite-backup service, docs/backup.md) ───────
# Encrypted daily pg_dump to Cloudflare R2, any S3-compatible store or any
# rclone remote. The service idles with a warning until a recipient and a
# destination are set. Dev compose writes to a local volume instead (profile
# "backup"); the prod compose also keeps its local ./backups service.
# age public key (age1...) from `backupctl keygen`; several may be given,
# separated by spaces or commas. The private key never goes on the server.
BACKUP_AGE_RECIPIENT=
# S3 destination. R2: https://<account id>.r2.cloudflarestorage.com and a
# bucket-scoped API token with Object Read & Write.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Defaults: auto / Cloudflare (rclone provider name, e.g. AWS, Minio, Wasabi).
BACKUP_S3_REGION=
BACKUP_S3_PROVIDER=
# Any rclone remote path instead of the S3 settings (e.g. /backups); wins
# over BACKUP_S3_* when set.
BACKUP_REMOTE=
# Object key prefix (default spotify-tracker): <prefix>/<YYYY>/<MM>/<name>.
BACKUP_PREFIX=
# Daily run time, HH:MM in UTC (default 03:00). true = also back up at start.
BACKUP_TIME=
BACKUP_ON_START=
# Minutes before the one retry after a failed run (default 30; 0 = no retry).
BACKUP_RETRY_MINUTES=
# Delete backups older than this many days (default 30; 0 = keep all), but
# always keep the newest BACKUP_KEEP_MIN (default 7).
BACKUP_KEEP_DAYS=
BACKUP_KEEP_MIN=
# Healthcheck turns unhealthy without a successful backup for this long
# (hours, default 26).
BACKUP_MAX_AGE_HOURS=
# Optional healthchecks.io-style URL: GET on success, <url>/fail on failure.
BACKUP_PING_URL=
