{
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true
	},
	"imports": {
		"@shared/": "../../packages/shared/",
		"@shared/schemas": "../../packages/shared/schemas.ts",
		"zod": "npm:zod@^4.3.6"
	},
	"tasks": {
		"dev": "deno run --allow-env --env --allow-net --watch src/index.ts",
		"start": "deno run --allow-env --allow-net src/index.ts",
		"check": "deno check src/*.ts",
		"lint": "deno lint src/*.ts",
		"fmt": "deno fmt src/*.ts",
		"fmt:check": "deno fmt --check src/*.ts"
	}
}
