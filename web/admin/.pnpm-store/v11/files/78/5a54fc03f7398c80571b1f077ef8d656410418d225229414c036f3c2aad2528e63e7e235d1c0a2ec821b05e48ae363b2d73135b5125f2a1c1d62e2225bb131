\n    organization,\n    connectionDomains,\n    enterpriseConnections,\n    connectionScope,\n    setScope,\n    createEnterpriseConnection,\n    updateEnterpriseConnection,\n    deleteEnterpriseConnection,\n  ]);\n\n  const testRuns = useMemo<TestRunsView>(\n    () => ({\n      rows: testRunRows,\n      totalCount: testRunTotalCount,\n      isLoading: isLoadingTestRuns,\n      isFetching: isFetchingTestRuns,\n      isPolling: isPollingTestRuns,\n      page: testRunPage,\n      setPage: setTestRunPage,\n      refresh: refreshTestRuns,\n      revalidateHasSuccessfulTestRun,\n    }),\n    [\n      testRunRows,\n      testRunTotalCount,\n      isLoadingTestRuns,\n      isFetchingTestRuns,\n      isPollingTestRuns,\n      testRunPage,\n      setTestRunPage,\n      refreshTestRuns,\n      revalidateHasSuccessfulTestRun,\n    ],\n  );\n\n  // The single domain entity everything downstream reads decisions from, keyed\n  // on the raw inputs so it is only rebuilt when one of them changes.\n  const organizationEnterpriseConnection = useMemo<OrganizationEnterpriseConnection>(\n    () =>\n      buildOrganizationEnterpriseConnection({\n        connection: enterpriseConnection,\n        hasSuccessfulTestRun,\n      }),\n    [enterpriseConnection, hasSuccessfulTestRun],\n  );\n\n  return {\n    user,\n    session,\n    organization,\n    // Test-runs gate the full skeleton only when a connection was present at\n    // first load — that case fetches them as part of the initial load. On the\n    // fresh-start path they stay dormant until the connection is configured, and\n    // landing on the test step then shows table-level loading, never the global\n    isLoading:\n      isLoadingEnterpriseConnections || isLoadingOrganizationDomains || (hadInitialConnection && isLoadingTestRuns),\n    enterpriseConnections,\n    connectionScope,\n    selectConnection,\n    enterpriseConnection,\n    connectionDomains,\n    setConnectionDomains,\n    claimedDomains,\n    organizationEnterpriseConnection,\n    enterpriseConnectionMutations,\n    testRuns,\n    organizationDomains,\n    organizationDomainMutations,\n  };\n};\n"],"mappings":";;;;;;;;;;;;;;;;AAgJA,MAAa,uCAAuC,EAClD,SAAS,SACe,CAAC,MAAiD;CAC1E,MAAM,EACJ,MAAM,mBACN,WAAW,gCACX,4BACA,4BACA,+BACE,gDAAgD,EAAE,SAAS,KAAK,CAAC;CAErE,MAAM,wBAAwB,cAAc,0BAA0B,qBAAqB,CAAC,CAAC,GAAG,CAAC,iBAAiB,CAAC;CAGnH,MAAM,CAAC,gBAAgB,qBAAqB,SAAiC,IAAI;CAEjF,MAAM,CAAC,cAAc,mBAAmB,SAA0B,IAAI;CAEtE,MAAM,WAAW,aAAa,SAAiC;EAC7D,kBAAkB,IAAI;EACtB,gBAAgB,IAAI;CACtB,GAAG,CAAC,CAAC;CAEL,MAAM,kBAAkB,cAEpB,mBACC,sBAAsB,KAAK;EAAE,MAAM;EAAY,IAAI,sBAAsB,EAAE,CAAC;CAAG,IAAI,EAAE,MAAM,MAAM,IACpG,CAAC,gBAAgB,qBAAqB,CACxC;CAEA,MAAM,uBACJ,gBAAgB,SAAS,aACrB,sBAAsB,MAAK,eAAc,WAAW,OAAO,gBAAgB,EAAE,IAC7E;CAEN,MAAM,mBAAmB,aAAa,SAA0B,SAAS,IAAI,GAAG,CAAC,QAAQ,CAAC;CAS1F,MAAM,0BAA0B,OAA4B,MAAS;CACrE,IAAI,wBAAwB,YAAY,UAAa,CAAC,gCACpD,wBAAwB,UAAU,QAAQ,oBAAoB;CAEhE,MAAM,uBAAuB,wBAAwB,YAAY;CAmBjE,MAAM,EACJ,sBACA,WAAW,mBACX,YAAY,oBACZ,MAAM,aACN,YAAY,mBACZ,WAAW,mBACX,MAAM,aACN,SAAS,gBACT,SAAS,iBACT,mCACE,gCAAgC,uBAblC,iCAAiC,oBAAoB,KAAK,QAAQ,sBAAsB,MAAM,MAapB,MAAM;CAElF,MAAM,EAAE,SAAS,QAAQ;CACzB,MAAM,EAAE,YAAY,WAAW;CAC/B,MAAM,EAAE,iBAAiB,gBAAgB;CAEzC,MAAM,iBAAiB,cACf,iCAAiC,uBAAuB,sBAAsB,EAAE,GACtF,CAAC,uBAAuB,oBAAoB,CAC9C;CA2BA,MAAM,EACJ,WAAW,8BACX,MAAM,qBACN,cACA,8BACA,8BACA,YAAY,sBACV,kCAAkC;EACpC,SAAS;EACT,gBAAgB;EAChB,qBAjCoC,YACpC,OAAO,oBAAkD;GACvD,MAAM,UAAU,uBAAwB,qBAAqB,WAAW,CAAC,IAAK;GAC9E,IAAI,YAAY,MACd;GAGF,MAAM,UAAU,MAAM,KACpB,IAAI,IAAI,CAAC,GAAG,SAAS,GAAG,gBAAgB,KAAI,WAAU,OAAO,IAAI,CAAC,CAAC,QAAO,SAAQ,CAAC,eAAe,IAAI,IAAI,CAAC,CAAC,CAAC,CAC/G;GACA,IAAI,QAAQ,WAAW,QAAQ,QAC7B;GAGF,IAAI,sBACF,MAAM,2BAA2B,qBAAqB,IAAI,EAAE,QAAQ,CAAC;QAErE,gBAAgB,OAAO;EAE3B,GACA;GAAC;GAAsB;GAAc;GAAgB;EAA0B,CAa9B;CACnD,CAAC;CAED,MAAM,oBAAoB,cAEtB,uBACK,qBAAqB,WAAW,CAAC,IACjC,gBAAgB,yBAAyB,qBAAqB,cAAc,GACnF;EAAC;EAAsB;EAAc;EAAqB;CAAc,CAC1E;CAEA,MAAM,uBAAuB,YAC3B,OAAO,YAAsB;EAC3B,IAAI,sBACF,MAAM,2BAA2B,qBAAqB,IAAI,EAAE,QAAQ,CAAC;OAErE,gBAAgB,OAAO;CAE3B,GACA,CAAC,sBAA